#!/usr/bin/env bash
# brightness-tui: interactive brightness control (aliased as "bri")
# Uses the precompiled BrightnessCtl.exe (WMI WmiMonitorBrightness/-Methods)
# instead of shelling out to powershell.exe each keypress, same pattern as
# AudioCtl.exe/BatteryCtl.exe -- keeps every adjustment feeling instant.

EXE='/mnt/c/Users/Admin/AppData/Local/BrightnessCtl.exe'

BAR_WIDTH=30
STEP=5

get_brightness() {
  # </dev/null is required: invoking a Windows .exe via WSL interop drains
  # whatever is on this script's stdin (even though the exe never reads it),
  # which would otherwise silently eat keystrokes typed during the loop below.
  "$EXE" get </dev/null 2>/dev/null | tr -d '\r'
}

set_brightness() {
  "$EXE" set "$1" </dev/null >/dev/null 2>&1
}

draw() {
  local pct=$1
  local filled=$(( pct * BAR_WIDTH / 100 ))
  local empty=$(( BAR_WIDTH - filled ))
  local bar
  bar=$(printf '█%.0s' $(seq 1 "$filled" 2>/dev/null))
  bar+=$(printf '░%.0s' $(seq 1 "$empty" 2>/dev/null))

  tput cup 0 0
  tput ed
  printf '\n'
  printf '  \033[1;33m☀ Brightness\033[0m\n\n'
  printf '  \033[1;32m%s\033[0m  %3d%%\n\n' "$bar" "$pct"
  printf '  \033[2m← / h  decrease   → / l  increase   q / Esc  quit\033[0m\n'
}

cleanup() {
  tput cnorm
  stty echo icanon
  printf '\n'
}
trap cleanup EXIT

stty -echo -icanon
tput civis
tput clear

pct=$(get_brightness)
[[ "$pct" =~ ^[0-9]+$ ]] || pct=50

draw "$pct"

while true; do
  key=$(dd bs=1 count=1 2>/dev/null)

  case "$key" in
    $'\x1b')
      rest=$(dd bs=1 count=2 2>/dev/null)
      case "$rest" in
        '[C') key='l' ;;  # right arrow
        '[D') key='h' ;;  # left arrow
        *) key='q' ;;     # bare Esc
      esac
      ;;
  esac

  case "$key" in
    l|L)
      pct=$(( pct + STEP ))
      (( pct > 100 )) && pct=100
      set_brightness "$pct"
      draw "$pct"
      ;;
    h|H)
      pct=$(( pct - STEP ))
      (( pct < 0 )) && pct=0
      set_brightness "$pct"
      draw "$pct"
      ;;
    q|Q)
      break
      ;;
  esac
done
